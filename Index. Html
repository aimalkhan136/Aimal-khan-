<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>DM Appointment Setter</title>

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;500;700&display=swap" rel="stylesheet">

<style>
body {
  margin: 0;
  font-family: 'Poppins', sans-serif;
  background: #0f172a;
  color: white;
}

/* ANIMATION */
@keyframes fadeUp {
  from {
    opacity: 0;
    transform: translateY(40px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.container {
  max-width: 1000px;
  margin: auto;
  padding: 30px;
}

/* HERO */
.hero {
  text-align: center;
  padding: 50px 20px;
  animation: fadeUp 1s ease;
}

.hero h1 {
  font-size: 40px;
  color: #00f5ff;
  margin-bottom: 10px;
}

.hero p {
  color: #cbd5e1;
}

/* CARDS */
.grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 20px;
  margin-top: 40px;
}

.card {
  background: #1e293b;
  padding: 20px;
  border-radius: 15px;
  opacity: 0;
  animation: fadeUp 1s ease forwards;
}

.card:nth-child(1) { animation-delay: 0.2s; }
.card:nth-child(2) { animation-delay: 0.4s; }
.card:nth-child(3) { animation-delay: 0.6s; }
.card:nth-child(4) { animation-delay: 0.8s; }

.card h3 {
  color: #00f5ff;
}

/* CONTACT */
.contact {
  text-align: center;
  margin-top: 50px;
  animation: fadeUp 1.2s ease;
}

.btn {
  display: inline-block;
  margin: 10px;
  padding: 12px 20px;
  border-radius: 10px;
  text-decoration: none;
  font-weight: bold;
}

.call {
  background: #22c55e;
  color: white;
}

.email {
  background: #3b82f6;
  color: white;
}

.footer {
  text-align: center;
  margin-top: 40px;
  color: #94a3b8;
}
</style>
</head>

<body>

<div class="container">

  <!-- HERO -->
  <div class="hero">
    <h1>DM Appointment Setter</h1>
    <p>I help businesses turn conversations into booked calls.</p>
  </div>

  <!-- SERVICES -->
  <div class="grid">

    <div class="card">
      <h3>Outreach</h3>
      <p>Sending targeted DMs to potential clients.</p>
    </div>

    <div class="card">
      <h3>Lead Qualification</h3>
      <p>Filtering serious buyers from cold leads.</p>
    </div>

    <div class="card">
      <h3>Appointment Booking</h3>
      <p>Booking calls directly into calendars.</p>
    </div>

    <div class="card">
      <h3>Follow Ups</h3>
      <p>Consistent follow-ups to close more deals.</p>
    </div>

  </div>

  <!-- CONTACT -->
  <div class="contact">
    <h2>Contact Me</h2>

    <a class="btn call" href="tel:03409146669">📞 Call Me</a>

    <a class="btn email" href="mailto:bazdara688@gmail.com">📧 Email Me</a>
  </div>

  <div class="footer">
    Let’s grow your business 🚀
  </div>

</div>

</body>
</html>
